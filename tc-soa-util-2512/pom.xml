<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.plm.tc.soa</groupId>
  <artifactId>tc-soa-util</artifactId>
  <version>2512.2611.03</version>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <lombok.version>1.18.36</lombok.version>
    <junit.version>5.11.3</junit.version>

    <tc.version>2512</tc.version>
    <log4j.version>2.25.5</log4j.version>
    <jspecify.version>1.0.0</jspecify.version>
    <slf4j.version>2.0.20</slf4j.version>
    <jaxb-api.version>2.3.1</jaxb-api.version>
    <jaxb-runtime.version>2.3.5</jaxb-runtime.version>
    <httpclient.version>4.5.13</httpclient.version>
    <xercesImpl.version>2.12.2</xercesImpl.version>
  </properties>

  <dependencies>
    <!-- project dependencies -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- teamcenter dependencies -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>${jspecify.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.xml.bind</groupId>
      <artifactId>jaxb-api</artifactId>
      <version>${jaxb-api.version}</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>${jaxb-runtime.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents</groupId>
      <artifactId>httpclient</artifactId>
      <version>${httpclient.version}</version>
    </dependency>
    <dependency>
      <groupId>xerces</groupId>
      <artifactId>xercesImpl</artifactId>
      <version>${xercesImpl.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.soa</groupId>
      <artifactId>tc-soa-common</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.soa</groupId>
      <artifactId>tc-soa-client</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.soa</groupId>
      <artifactId>tc-soa-strong-model</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.services</groupId>
      <artifactId>tc-soa-core-strong</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.services</groupId>
      <artifactId>tc-soa-query-strong</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.services</groupId>
      <artifactId>tc-soa-import-export-strong</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.services</groupId>
      <artifactId>tc-soa-cad-strong</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.services</groupId>
      <artifactId>tc-soa-classification-strong</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.services</groupId>
      <artifactId>tc-soa-administration-strong</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.services</groupId>
      <artifactId>tc-soa-workflow-strong</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.services</groupId>
      <artifactId>tc-soa-structure-management-strong</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.fms</groupId>
      <artifactId>fccclient</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.net</groupId>
      <artifactId>tcserver</artifactId>
      <version>${tc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teamcenter.logging</groupId>
      <artifactId>tclogging</artifactId>
      <version>${tc.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Bundle the Java EE JAXB 2.3 runtime into this artifact so consuming
        applications only need one tc-soa-util dependency.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <dependencyReducedPomLocation>
                ${project.build.directory}/dependency-reduced-pom.xml
              </dependencyReducedPomLocation>
              <useDependencyReducedPomInJar>true</useDependencyReducedPomInJar>
              <artifactSet>
                <includes>
                  <include>javax.xml.bind:jaxb-api</include>
                  <include>org.glassfish.jaxb:jaxb-runtime</include>
                  <include>org.glassfish.jaxb:txw2</include>
                  <include>com.sun.istack:istack-commons-runtime</include>
                  <include>com.sun.activation:jakarta.activation</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
